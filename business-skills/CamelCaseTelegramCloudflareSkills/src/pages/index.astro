---
import BaseLayout from '@/layouts/BaseLayout.astro';

const webhookPath = '/api/telegram/webhook';
---

<BaseLayout
  title="Astro Telegram Bot"
  description="Минимальный шаблон Telegram-бота на Astro 5 и Cloudflare Pages"
>
  <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16">
    <section class="w-full rounded-3xl border border-zinc-800 bg-zinc-900/70 p-8 shadow-2xl shadow-black/20 sm:p-12">
      <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-sm text-emerald-300">
        <span class="size-2 rounded-full bg-emerald-400"></span>
        Astro 5 · Cloudflare Pages
      </div>

      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        Telegram bot template
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-400">
        Чистая отправная точка: webhook принимает обновления Telegram, проверяет секретный заголовок и отвечает на команды
        <code class="text-zinc-200">/start</code> и <code class="text-zinc-200">/ping</code>.
      </p>

      <dl class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-5">
          <dt class="text-sm text-zinc-500">Webhook</dt>
          <dd class="mt-2 break-all font-mono text-sm text-zinc-200">{webhookPath}</dd>
        </div>
        <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-5">
          <dt class="text-sm text-zinc-500">Health check</dt>
          <dd class="mt-2 font-mono text-sm text-zinc-200">/api/health</dd>
        </div>
      </dl>
    </section>
  </main>
</BaseLayout>
