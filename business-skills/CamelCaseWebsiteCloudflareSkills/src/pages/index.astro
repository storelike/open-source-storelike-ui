---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  advantages,
  faq,
  highlights,
  services,
  site,
  steps,
} from '@/config/site';
---

<BaseLayout title={site.title} description={site.description}>
  <header class="absolute inset-x-0 top-0 z-20">
    <div class="page-container flex h-24 items-center justify-between">
      <a class="flex items-center gap-3 font-semibold tracking-tight" href="#top" aria-label={`${site.name}: на главную`}>
        <span class="grid size-11 place-items-center rounded-full bg-coral text-sm font-bold text-white">{site.shortName}</span>
        <span>{site.name}</span>
      </a>
      <nav class="hidden items-center gap-8 text-sm font-medium md:flex" aria-label="Основная навигация">
        <a class="nav-link" href="#services">Услуги</a>
        <a class="nav-link" href="#about">О нас</a>
        <a class="nav-link" href="#process">Как работаем</a>
      </nav>
      <a class="button button--dark hidden sm:inline-flex" href={site.phoneHref}>Позвонить</a>
    </div>
  </header>

  <main id="top">
    <section class="relative overflow-hidden bg-cream pb-20 pt-36 sm:pb-28 sm:pt-44">
      <div class="hero-orb hero-orb--one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb--two" aria-hidden="true"></div>
      <div class="page-container relative grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="eyebrow">{site.eyebrow}</p>
          <h1 class="mt-6 max-w-3xl text-5xl font-semibold leading-[0.98] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
            {site.heroTitle}
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-stone-600 sm:text-xl">{site.heroText}</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a class="button button--accent" href={site.primaryAction.href}>{site.primaryAction.label}</a>
            <a class="button button--light" href={site.secondaryAction.href}>{site.secondaryAction.label}</a>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-lg lg:ml-auto">
          <div class="rounded-[2.25rem] bg-ink p-7 text-white shadow-2xl shadow-stone-900/15 sm:p-9">
            <p class="text-sm font-medium uppercase tracking-[0.18em] text-white/50">Первый шаг</p>
            <p class="mt-16 text-3xl font-medium leading-tight tracking-tight sm:text-4xl">
              Расскажите, какой результат вам нужен.
            </p>
            <p class="mt-5 max-w-sm leading-7 text-white/65">
              Мы зададим уточняющие вопросы и предложим понятный следующий шаг.
            </p>
            <a class="mt-10 inline-flex items-center gap-3 border-b border-white/30 pb-1 font-medium" href={`mailto:${site.email}`}>
              {site.email}<span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="absolute -bottom-7 -left-5 rounded-3xl bg-white p-5 shadow-xl shadow-stone-900/10 sm:-left-10 sm:p-6">
            <span class="block text-2xl" aria-hidden="true">✦</span>
            <span class="mt-2 block max-w-32 text-sm font-medium leading-5">Условия заранее, без сюрпризов</span>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-stone-200 bg-white">
      <dl class="page-container grid divide-y divide-stone-200 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        {highlights.map((item) => (
          <div class="py-8 sm:px-8 sm:first:pl-0 sm:last:pr-0">
            <dt class="text-2xl font-semibold tracking-tight">{item.value}</dt>
            <dd class="mt-1 text-sm leading-6 text-stone-500">{item.label}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section bg-white" id="services">
      <div class="page-container">
        <div class="section-heading">
          <p class="eyebrow">Что мы делаем</p>
          <h2>Услуги, которые ведут к понятному результату</h2>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          {services.map((service) => (
            <article class="service-card">
              <span class="text-sm font-semibold text-coral">{service.number}</span>
              <h3 class="mt-12 text-2xl font-semibold tracking-tight">{service.title}</h3>
              <p class="mt-4 leading-7 text-stone-600">{service.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-ink text-white" id="about">
      <div class="page-container grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <div>
          <p class="eyebrow eyebrow--light">Наш подход</p>
          <h2 class="mt-5 text-4xl font-semibold tracking-tight sm:text-5xl">Понятный процесс — часть хорошего результата</h2>
        </div>
        <div class="divide-y divide-white/15 border-t border-white/15">
          {advantages.map((advantage, index) => (
            <article class="grid gap-4 py-7 sm:grid-cols-[3rem_1fr]">
              <span class="text-sm text-white/40">0{index + 1}</span>
              <div>
                <h3 class="text-xl font-medium">{advantage.title}</h3>
                <p class="mt-2 max-w-xl leading-7 text-white/60">{advantage.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-stone-100" id="process">
      <div class="page-container">
        <div class="section-heading">
          <p class="eyebrow">Три шага</p>
          <h2>От первого сообщения до готового результата</h2>
        </div>
        <ol class="mt-12 grid gap-4 md:grid-cols-3">
          {steps.map((step, index) => (
            <li class="rounded-3xl border border-stone-200 bg-white p-7">
              <span class="grid size-10 place-items-center rounded-full bg-cream text-sm font-semibold">{index + 1}</span>
              <h3 class="mt-8 text-xl font-semibold">{step.title}</h3>
              <p class="mt-3 leading-7 text-stone-600">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section bg-white">
      <div class="page-container grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
        <div class="section-heading">
          <p class="eyebrow">Коротко о важном</p>
          <h2>Частые вопросы</h2>
        </div>
        <div class="divide-y divide-stone-200 border-t border-stone-200">
          {faq.map((item) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold">
                {item.question}<span class="text-2xl font-light text-coral transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="max-w-2xl pt-4 leading-7 text-stone-600">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-coral py-20 text-white sm:py-24" id="contacts">
      <div class="page-container grid items-end gap-12 lg:grid-cols-[1fr_auto]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-white/65">Связаться</p>
          <h2 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight tracking-tight sm:text-6xl">Обсудим вашу задачу?</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-white/75">Напишите удобным способом. Ответим в рабочее время и договоримся о следующем шаге.</p>
        </div>
        <div class="flex flex-col items-start gap-3 lg:items-end">
          <a class="text-2xl font-semibold sm:text-3xl" href={site.phoneHref}>{site.phone}</a>
          <a class="border-b border-white/40 pb-1 text-lg" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink py-10 text-white">
    <div class="page-container grid gap-8 text-sm text-white/60 sm:grid-cols-3">
      <p class="font-medium text-white">{site.name}</p>
      <p>{site.address}<br />{site.hours}</p>
      <p class="sm:text-right">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </footer>
</BaseLayout>
