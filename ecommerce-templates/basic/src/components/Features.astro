---
import { Icon } from "astro-icon/components";
import { cmFeatures } from "../locale/cms-locale.json";

// Interfaces for typing
interface FeatureItem {
  title: string;
  description: string;
  icon: string;
}

interface StyleProperty {
  label: string;
  value: string | FeatureItem[];
}

interface FeaturesData {
  labelSection: string;
  title: StyleProperty;
  subtitle: StyleProperty;
  items: StyleProperty;
}

// Cast the type and extract the data
const featuresData = cmFeatures as unknown as FeaturesData;
const title = featuresData?.title?.value as string || "";
const subtitle = featuresData?.subtitle?.value as string || "";
const items = featuresData?.items?.value as FeatureItem[] || [];
---

<section class="py-20 lg:py-28">
  <div class="max-w-2xl">
    <p class="font-mono text-eyebrow uppercase tracking-[0.2em] text-muted">
      Why aikit
    </p>
    <h2 class="mt-6 text-3xl text-text sm:text-4xl lg:text-5xl lg:tracking-tight">
      {title}
    </h2>
    <p class="mt-6 text-lg leading-relaxed text-secondary">
      {subtitle}
    </p>
  </div>

  <div class="mt-16 grid gap-px overflow-hidden rounded-sm border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <div class="bg-bg p-8 transition-colors hover:bg-surface">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm border border-border-strong bg-surface text-accent">
            <Icon class="h-5 w-5" name={item.icon} />
          </div>
          <h3 class="mt-6 text-lg font-medium text-text">{item.title}</h3>
          <p class="mt-2 leading-relaxed text-secondary">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>
